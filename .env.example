# Copy this file to .env. Values are read by the local Node server only.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=your-provider-model-id
AI_API_KEY=your-key-here

# OpenRouter: automatically retry recoverable failures with up to two catalog-verified free models.
# Set to false to turn off extra requests (each attempt counts toward your provider's limits).
AI_FREE_FALLBACK=true

# Optional live research search. Without this key, research produces an explicitly labeled plan.
# Search results are snippets and links; webpage content is not fetched or verified.
BRAVE_SEARCH_API_KEY=

# Optional; the API listens on localhost by default.
API_PORT=3001

# Optional; callback URL used by the "Connect OpenRouter" browser authorization flow.
# Defaults to http://127.0.0.1:<API_PORT>/api/providers/openrouter/callback. Only change it
# if you serve the API from a different origin; OpenRouter supports localhost on any port.
# OPENROUTER_REDIRECT_URI=http://127.0.0.1:3001/api/providers/openrouter/callback
