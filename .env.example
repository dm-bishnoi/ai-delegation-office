# Copy this file to .env. Values are read by the local Node server only.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=your-provider-model-id
AI_API_KEY=your-key-here

# OpenRouter: automatically retry recoverable failures with up to two catalog-verified free models.
# Set to false to turn off extra requests (each attempt counts toward your provider's limits).
AI_FREE_FALLBACK=true

# Optional; the API listens on localhost by default.
API_PORT=3001
